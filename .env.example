# --- Telegram API (my.telegram.org -> API development tools) ---
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# --- Бот-интерфейс (@BotFather) ---
BOT_TOKEN=123456:AAA-BBB

# --- Кому разрешено пользоваться ботом (свой ID узнать у @userinfobot) ---
# Несколько ID через запятую. Пусто = доступ всем (не рекомендуется).
OWNER_IDS=123456789

# --- Файлы ---
SESSION_NAME=parser            # имя файла сессии Telethon (parser.session)
DB_PATH=parser.db

# --- Параметры поиска по умолчанию ---
SEARCH_DAYS=30                 # глубина поиска в днях (0 = без ограничения по дате)
PER_CHAT_LIMIT=500             # максимум сообщений на чат за один прогон
MATCH_MODE=smart               # smart | exact | substring
SCAN_MODE=false                # false = серверный поиск Telegram, true = локальное сканирование истории
AUTO_JOIN=false                # true = автоматически вступать в чаты по ссылке

# --- Защита от FloodWait ---
REQUEST_DELAY=0.7              # пауза между запросами, сек
MAX_FLOOD_WAIT=120             # ждать не дольше, сек (иначе пропустить чат)
MEDIA_TIMEOUT=120              # сколько ждать скачивание одного вложения при выгрузке в HTML, сек
